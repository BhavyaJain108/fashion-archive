# The scraper's own image, not the API's.
#
# Most brands need only plain HTTP and a bulk-JSON endpoint, and several that refused it
# are now reachable over T1 — a real browser's TLS handshake without a browser (curl_cffi,
# ~5 MB). So this still carries no Chromium and is a few hundred MB rather than a gigabyte.
#
# One brand does need a browser: Gentle Monster sits behind an AWS WAF challenge that only
# a page running its own script can pass. But only to mint a cookie — measured 2026-09-21,
# the browser is up for 2.5s and every page after that is ordinary HTTP carrying the token,
# 0.3s each. So the cost is not a browser per page; it is a 500 MB spike for 2.5 seconds,
# once per run, against 33 MB the rest of the time.
#
# Chromium is still left out because 500 MB does not fit a 512 MB starter worker with any
# confidence, and the daemon runs two of them. The API's Dockerfile already keeps Playwright
# for runway scraping, so a scheduled job on that image is the cheaper home. Until then
# Gentle Monster is refreshed by hand with `scrape --browser`.
#
# It stores nothing locally. The catalogue and the photographs both go to R2, so the
# container is disposable and it does not matter whether it runs on a laptop, a VM or
# a worker.
#
# 2026-09-22: Chromium is in after all, and the worker moved to a plan that fits it. The
# argument above was right about cost — a browser per page is unaffordable — and wrong
# about what the browser is for: it mints one cookie per run and is put away. Same base
# image as the API, so the playwright pin and the browsers it ships stay in step.
FROM mcr.microsoft.com/playwright/python:v1.40.0-jammy

WORKDIR /app

# Dependencies first, so this layer is cached unless they change. Its own list rather
# than the API's minus a few lines: subtracting left opencv-python, yt-dlp, numpy and
# Pillow in an image that opens none of them.
COPY requirements-scraper.txt .
RUN pip install --no-cache-dir -r requirements-scraper.txt

COPY backend/__init__.py backend/__init__.py
COPY backend/archive backend/archive
COPY backend/storage backend/storage
COPY config config

# Unbuffered, or a long pass's progress sits in a pipe until it finishes.
ENV PYTHONUNBUFFERED=1

# Not root: the pages are other people's and the environment holds the bucket's
# keys. pwuser ships with the Playwright image and owns its browsers; the two
# directories a run writes on disk are handed to it.
RUN mkdir -p backend/archive/data/logs backend/archive/data/locks locks \
    && chown -R pwuser:pwuser /app
USER pwuser

ENTRYPOINT ["python", "-m", "backend.archive.runner.cli"]
CMD ["status"]
