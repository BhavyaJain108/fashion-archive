# Copy to config/.env. The API and the scraper read this locally; on Render the
# same keys are set per service in render.yaml and the dashboard.

# --- the archive (both the API and the scraper) ---------------------------------
# Cloudflare R2: the catalogue, the schedule, the photographs. Without these the
# scraper writes to a local directory and the site shows nothing.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=fashion-archive
R2_PUBLIC_BASE=https://images.premiumpropogandafashion.studio

# The finder: the one part that spends money. The cap is per day, fleet-wide.
ANTHROPIC_API_KEY=
FINDER_DAILY_USD=10
# FINDER_MODEL=claude-sonnet-5

# The country the catalogue is priced for. A Shopify store with Markets prices each
# country itself (kuurth.com: 34.95 EUR at home, 52.00 USD here), and the feed is
# asked for this market. Stores without it keep their own currency; the site converts
# those for display. Empty takes every shop's home prices.
ARCHIVE_MARKET=US

# Use a directory instead of the bucket (tests, offline work).
# ARCHIVE_OBJECTS=/path/to/objects

# --- the API only -------------------------------------------------------------------
DATABASE_URL=postgresql://localhost/fashion_archive
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8081
# COOKIE_DOMAIN=
# COOKIE_SECURE=false
# Who may open /dev, comma-separated.
ADMIN_EMAILS=
# Sign-in providers. With none set, the verification link prints to the terminal.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
# RESEND_API_KEY=

# The costs page reads the providers' own numbers with these.
# ANTHROPIC_ADMIN_KEY=
# CLOUDFLARE_API_TOKEN=
# RENDER_API_KEY=

# High Fashion (runway seasons) only.
# YOUTUBE_API_KEY=
