{
  "$description": "Fashion Archive design tokens. Generated from web_ui/src/shared/styles/archive.css by scripts/export-tokens.js — edit the CSS, not this file.",
  "color": {
    "bg": {
      "$type": "color",
      "$value": "#ffffff",
      "$description": "page ground"
    },
    "bg-sub": {
      "$type": "color",
      "$value": "#fafafa",
      "$description": "sidebars, strips, toolbars"
    },
    "bg-sunk": {
      "$type": "color",
      "$value": "#f5f5f5",
      "$description": "wells: image placeholders, pressed hover, scrollbar track"
    },
    "line": {
      "$type": "color",
      "$value": "#e0e0e0",
      "$description": "hairline rules, scrollbar thumb"
    },
    "line-soft": {
      "$type": "color",
      "$value": "#ededed",
      "$description": "rules inside a grouped block"
    },
    "ink": {
      "$type": "color",
      "$value": "#000000",
      "$description": "selected / active"
    },
    "ink-2": {
      "$type": "color",
      "$value": "#666666",
      "$description": "body"
    },
    "ink-3": {
      "$type": "color",
      "$value": "#767676",
      "$description": "labels, idle controls, counts, placeholders — 4.5:1, AA"
    },
    "ink-4": {
      "$type": "color",
      "$value": "#949494",
      "$description": "disabled text and glyph-only controls — 3:1, never for readable text"
    },
    "danger": {
      "$type": "color",
      "$value": "#cc0000",
      "$description": "destructive confirmation ONLY"
    },
    "wash": {
      "$type": "color",
      "$value": "rgba(0, 0, 0, 0.02)",
      "$description": "hover"
    },
    "wash-strong": {
      "$type": "color",
      "$value": "rgba(0, 0, 0, 0.03)",
      "$description": "selected"
    },
    "scrim": {
      "$type": "color",
      "$value": "rgba(0, 0, 0, 0.28)",
      "$description": "behind a panel that has focus"
    },
    "shield": {
      "$type": "color",
      "$value": "rgba(0, 0, 0, 0.9)",
      "$description": "over a video while it loads"
    }
  },
  "font": {
    "family": {
      "mono": {
        "$type": "fontFamily",
        "$value": [
          "JetBrains Mono",
          "SF Mono",
          "Monaco",
          "monospace"
        ]
      }
    },
    "size": {
      "micro": {
        "$type": "dimension",
        "$value": "9px",
        "$description": "counts, timestamps, meta under a name"
      },
      "label": {
        "$type": "dimension",
        "$value": "10px",
        "$description": "section headers, facet labels, tiny controls"
      },
      "ui": {
        "$type": "dimension",
        "$value": "11px",
        "$description": "buttons, inputs, chips, status bar"
      },
      "body": {
        "$type": "dimension",
        "$value": "12px",
        "$description": "list rows, notes, everything readable"
      },
      "heading": {
        "$type": "dimension",
        "$value": "13px",
        "$description": "the name at the top of a panel or album"
      },
      "title": {
        "$type": "dimension",
        "$value": "24px",
        "$description": "the one big thing on a page, and empty-state glyphs"
      }
    },
    "tracking": {
      "tight": {
        "$type": "dimension",
        "$value": "0.05em",
        "$description": "a name that needs a little air"
      },
      "ui": {
        "$type": "dimension",
        "$value": "0.1em",
        "$description": "buttons, chips, inputs, status"
      },
      "label": {
        "$type": "dimension",
        "$value": "0.15em",
        "$description": "section headers, placeholders, empty states"
      },
      "wide": {
        "$type": "dimension",
        "$value": "0.2em",
        "$description": "the wordmark"
      }
    },
    "lineHeight": {
      "none": {
        "$type": "number",
        "$value": 1,
        "$description": "a glyph or a single-line control"
      },
      "ui": {
        "$type": "dimension",
        "$value": "16px",
        "$description": "rows, labels, anything 9–12px"
      },
      "body": {
        "$type": "dimension",
        "$value": "20px",
        "$description": "paragraphs, notes, the heading size"
      }
    },
    "weight": {
      "text": {
        "$type": "fontWeight",
        "$value": 400,
        "$description": "everything readable"
      },
      "emphasis": {
        "$type": "fontWeight",
        "$value": 600,
        "$description": "emphasis inside content"
      },
      "selected": {
        "$type": "fontWeight",
        "$value": 700,
        "$description": "the selected row or chip"
      }
    }
  },
  "space": {
