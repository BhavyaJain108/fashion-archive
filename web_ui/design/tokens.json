      "$value": "48px"
    }
  },
  "size": {
    "sidebar-w": {
      "$type": "dimension",
      "$value": "280px"
    },
    "topbar-h": {
      "$type": "dimension",
      "$value": "48px"
    },
    "statusbar-h": {
      "$type": "dimension",
      "$value": "36px"
    },
    "hairline": {
      "$type": "dimension",
      "$value": "1px"
    },
    "marker": {
      "$type": "dimension",
      "$value": "2px",
      "$description": "the left bar on a selected row or chip"
    }
